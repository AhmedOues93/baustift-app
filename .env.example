# =============================================================================
# Baustift — Umgebungsvariablen
# =============================================================================
# Kopieren nach .env.local und ausfüllen:  cp .env.example .env.local
# .env.local ist in .gitignore — echte Keys NIEMALS committen.
#
# Regel: alles mit NEXT_PUBLIC_ landet im Browser-Bundle und ist damit
# öffentlich. Alle anderen Werte bleiben serverseitig.
# =============================================================================

# --- App ---------------------------------------------------------------------
# Basis-URL der App (für Auth-Redirects und Stripe-Rückleitungen).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ----------------------------------------------------------------
# Dashboard → Project Settings → API
# WICHTIG für den Verkauf in Deutschland: das Projekt in einer EU-Region
# anlegen (Frankfurt). Ein US-Projekt lässt sich später nicht umziehen.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service-Role-Key: umgeht RLS komplett. Nur serverseitig (Stripe-Webhook,
# Protokollierung der KI-Nutzung). Darf nie ins Frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Anthropic (Claude) ------------------------------------------------------
# Wandelt das Transkript in strukturierte Angebotspositionen um.
# Key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI (Whisper) --------------------------------------------------------
# Sprachaufnahme → deutscher Text.
OPENAI_API_KEY=sk-...

# --- Stripe (Monats-Abo) -----------------------------------------------------
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# Preis-ID des Abo-Produkts (Product → Pricing → API ID, beginnt mit price_).
STRIPE_PRICE_ID=price_...
# Signing secret des Webhook-Endpoints für /api/stripe/webhook.
# Lokal:  stripe listen --forward-to localhost:3000/api/stripe/webhook
# Diese Ereignisse abonnieren: checkout.session.completed,
# customer.subscription.created/updated/deleted
STRIPE_WEBHOOK_SECRET=whsec_...

# --- E-Mail (optional) -------------------------------------------------------
# Für den Versand von Angeboten und Rechnungen an den Kunden.
# Ohne diese beiden Werte läuft die App normal weiter — der Versandknopf
# verschwindet einfach und man lädt das PDF herunter.
# Key: https://resend.com/api-keys ; die Absender-Domain muss dort verifiziert sein.
RESEND_API_KEY=re_...
RESEND_ABSENDER="Baustift <angebote@deine-domain.de>"

# --- Monitoring (optional) ---------------------------------------------------
# Ohne DSN schreibt die App nur ins eigene Log. Mit DSN gehen Fehler
# zusätzlich an Sentry — ohne SDK, nur ein POST pro Ereignis.
# DSN: Sentry → Projekt → Settings → Client Keys
SENTRY_DSN=https://xxxx@o000000.ingest.sentry.io/000000
